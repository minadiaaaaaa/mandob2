{
  "manifest_version": 3,
  "name": "Mandoob — sync",
  "version": "1.0.0",
  "description": "Sends the report tables open in this tab to Mandoob (مندوب).",
  "action": { "default_popup": "popup.html", "default_title": "Send report to the platform" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
