{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm -C web install --frozen-lockfile",
  "buildCommand": "pnpm -C web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mandoob-api-gateway.mizadiaa04.workers.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
