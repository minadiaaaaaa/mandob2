# Copy to .env. The /setup wizard can also take these on first run (it writes server/data/config.json).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_SSL_CA_FILE=../database/supabase/prod-ca-2021.crt
DB_POOL_SIZE=5
HOST=127.0.0.1

PORT=4000
# Set to 1 behind a reverse proxy so client IPs (for lockouts and IP blocks) are read from X-Forwarded-For.
TRUST_PROXY=0
# Optional: base64 32-byte key for encrypting "Private keys". If unset, server/data/app.key is generated.
# APP_KEY=

# Restricted NOINHERIT/NOBYPASSRLS login for authenticated application requests.
# Member of mandoob_request only; DATABASE_URL is reserved for trusted server operations.
DATABASE_APP_URL=
