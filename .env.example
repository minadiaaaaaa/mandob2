# Copy to .env. The /setup wizard can also take the database on first run (it writes server/data/config.json).

# MySQL 8 or MariaDB 10.6+ (Hostinger: hPanel › Databases › MySQL Databases; open it with phpMyAdmin).
# Percent-encode special characters in the password (@ → %40, # → %23).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/mandoob
# or the same as separate keys:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=mandoob
# DB_PASSWORD=
# DB_NAME=mandoob
# DB_SSL=0                 # 1 for a remote server that requires TLS
# DB_SSL_CA_FILE=          # optional CA certificate, relative to server/
DB_POOL_SIZE=10

# The platform owner (Super Admin of the whole platform), created at the first start.
# Without OWNER_PASSWORD a random one is written to server/data/first-login.txt.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=
OWNER_NAME=Platform owner
PLATFORM_NAME=مندوب

HOST=127.0.0.1
PORT=4000
# Set to 1 behind a reverse proxy so client IPs (for lockouts and IP blocks) are read from X-Forwarded-For.
# number of proxy hops in front of the server (1 = one Nginx), or their addresses separated by commas; 0 = none
TRUST_PROXY=0
# Optional: base64 32-byte key for encrypting "Private keys". If unset, server/data/app.key is generated.
# APP_KEY=
